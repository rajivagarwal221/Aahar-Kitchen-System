node_modules/
dist/
.vite/
.DS_Store
*.log
tsconfig.tsbuildinfo
.env.local
.claude/
.env
.env.*
!.env.example

# Local promotion records written by training/promote.py (contain machine paths)
backend/.promoted*.json
backend/best.pt
backend/best.onnx

# graphify
graphify-out/

# YOLO training (large binaries, local-only)
data/images/**/*.jpg
data/images/**/*.jpeg
data/images/**/*.png
data/images/**/*.webp
data/labels/**/*.txt
runs/
*.pt
*.onnx
*.tflite
*.hdf5
*.h5
!data/images/**/.gitkeep
# Smoke-test tripwire written by datasets/scripts/make_smoke_dataset.py
# is intentionally local-only — never commit it.
data/images/**/.AHAAR_SMOKE_MARKER
!data/labels/**/.gitkeep

# Fetched raw datasets — gigabytes, reproducible from fetch scripts.
# Never commit. Preserve the directory with a .gitkeep so the layout
# ships, but every actual dataset payload stays local.
datasets/raw/**
!datasets/raw/.gitkeep
!datasets/raw/**/
!datasets/raw/**/.gitkeep
# Small recipe/nutrition CSVs that are committed on purpose:
# datasets/scripts/build_recipes.py reads them to build public/recipes.json.
!datasets/raw/recipes/**/*.csv
!datasets/raw/nutrition/**/*.csv

# Training outputs — results dirs, metrics, and any ultralytics fallback
# path. Keep the results/ folder itself (via .gitkeep) so paths work.
results/**
!results/.gitkeep
# Small metrics and plots the report cites stay tracked; weights do not.
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.png
!results/**/*.yaml
results/**/weights/

# TensorFlow/Keras checkpoint shards sometimes shipped with Kaggle
# drops (variables.data-00000-of-00001 etc.) — also binary and huge.
**/variables/variables.*
