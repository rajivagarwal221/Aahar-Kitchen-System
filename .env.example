# Copy to .env.local. Where the browser sends photos for detection.
VITE_DETECT_URL=http://localhost:8000/detect

# Login (Firebase Authentication). Firebase console > Project settings > Your apps > Web app.
# Leave these empty to run AHAAR without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: point login at the Firebase Auth emulator instead of a real project.
# Start it with: firebase emulators:start --only auth --project demo-ahaar
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
